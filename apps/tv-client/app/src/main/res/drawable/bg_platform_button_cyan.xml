<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Elevated dark cyan surface with crisp 2dp neon cyan stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0C273E" />
            <stroke android:width="2dp" android:color="#22D3EE" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#051421" />
            <stroke android:width="1.5dp" android:color="#0E7490" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal resting state: Dark translucent cyan glass with subtle 1.2dp border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#071B2B" />
            <stroke android:width="1.2dp" android:color="#0891B2" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
