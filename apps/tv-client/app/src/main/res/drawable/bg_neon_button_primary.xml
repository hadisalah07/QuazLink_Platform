<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Glowing white/cyan neon frame with full illumination -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22D3EE" />
            <stroke android:width="3.5dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#06B6D4" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal resting state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E7490" />
            <stroke android:width="1.5dp" android:color="#22D3EE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
