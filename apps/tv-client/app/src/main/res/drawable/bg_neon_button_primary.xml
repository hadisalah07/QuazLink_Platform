<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Deep contrast navy with brilliant 3.5dp Neon Cyan stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#163354" />
            <stroke android:width="3.5dp" android:color="#22D3EE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0E4A78" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal state: Solid cyan accent with clean contrast -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E7490" />
            <stroke android:width="1.5dp" android:color="#22D3EE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
