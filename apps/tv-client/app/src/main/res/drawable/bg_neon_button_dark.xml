<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Deep navy background with vibrant 3.5dp Neon Cyan outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2D4A" />
            <stroke android:width="3.5dp" android:color="#22D3EE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A5F" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal resting state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="1.2dp" android:color="#334155" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
