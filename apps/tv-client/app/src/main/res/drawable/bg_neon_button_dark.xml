<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#15223A" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#080E1A" />
            <stroke android:width="1.5dp" android:color="#334155" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0C1424" />
            <stroke android:width="1.2dp" android:color="#1E293B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
