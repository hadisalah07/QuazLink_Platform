<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: bright neon white border over cyan -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22D3EE" />
            <stroke android:width="3.5dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22D3EE" />
            <stroke android:width="1.5dp" android:color="#22D3EE" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
