<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Elevated dark emerald surface with crisp 2dp neon emerald stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0A2B24" />
            <stroke android:width="2dp" android:color="#34D399" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#041613" />
            <stroke android:width="1.5dp" android:color="#059669" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal resting state: Dark translucent emerald glass with subtle 1.2dp border (Matching Platform) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#061D19" />
            <stroke android:width="1.2dp" android:color="#10B981" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
