<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Unselected mode pops out with Neon Cyan frame & deep navy body -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2D4A" />
            <stroke android:width="3.5dp" android:color="#22D3EE" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal state when unselected -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="1.2dp" android:color="#334155" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
