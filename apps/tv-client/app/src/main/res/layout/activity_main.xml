<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quaz_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="32dp">

        <!-- Header: Official QuazLink Logo & Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/quazlink_logo"
                android:contentDescription="QuazLink Logo"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUAZHOME TV"
                android:textColor="@color/quaz_cyan"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإصدار: v1.0.3 (Official Edition)"
                android:textColor="@color/quaz_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#2022D3EE"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- OTA Update Available Banner (Visible when update detected) -->
        <LinearLayout
            android:id="@+id/cardUpdateAvailable"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_device_card_focused"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvUpdateTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚀 يتوفر تحديث جديد! اضغط هنا للتحديث الفوري"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUpdateNow"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/quaz_cyan"
                    android:text="تحديث الآن (Update)"
                    android:textColor="@color/quaz_bg"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:focusable="true" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbUpdateDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progressTint="@color/quaz_cyan"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Main Card: QR Code & Mobile Pairing -->
        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_device_card_normal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <!-- QR Code Frame -->
            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:background="#FFFFFF"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pairing QR Code" />

                <ProgressBar
                    android:id="@+id/pbQrLoading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/quaz_cyan" />
            </FrameLayout>

            <!-- Pairing Instructions & PIN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اقتران التلفزيون بـ Home Assistant"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="امسح الـ QR بكاميرا الموبايل لتسجيل الدخول وربط أجهزة المنزل الذكي في ثوانٍ."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- PIN Code Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2022D3EE"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="كود الشاشة: "
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPairingCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QL-----"
                        android:textColor="@color/quaz_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- Live Status -->
                <TextView
                    android:id="@+id/tvPairingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الحالة: في انتظار المسح من الموبايل..."
                    android:textColor="#FBBF24"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Controls -->
        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Test Overlay Button -->
            <Button
                android:id="@+id/btnTestOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/quaz_cyan"
                android:text="تجربة فتح القائمة العائمة الآن (Test Overlay)"
                android:textColor="@color/quaz_bg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <!-- Accessibility Button -->
            <Button
                android:id="@+id/btnOpenAccessibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/quaz_bg_card"
                android:text="تفعيل خدمة التقاط أزرار الريموت (Accessibility)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:focusable="true" />

            <!-- Reset Pairing Button -->
            <Button
                android:id="@+id/btnResetPairing"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#1F2937"
                android:text="إعادة توليد كود الاقتران (Refresh QR)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
