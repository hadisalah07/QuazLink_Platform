<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060913">

    <!-- Dynamic Constellation Particle Background (Matching Web Platform) -->
    <com.quazcode.quazhome.tv.ui.view.StarFieldView
        android:id="@+id/starFieldBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="20dp"
            android:gravity="center_horizontal">

            <!-- Top Header: Logo + Title + Version + OTA Banner -->
            <LinearLayout
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/quazlink_logo"
                    android:contentDescription="QuazLink Logo"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUAZHOME TV"
                        android:textColor="#38BDF8"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="منظومة التحكم بالمنزل الذكي عبر شاشة التلفزيون والبروجكتور"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الإصدار: v1.1.4 (Platform Edition)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="@drawable/bg_platform_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp" />
            </LinearLayout>

            <!-- Optional OTA In-App Update Card -->
            <LinearLayout
                android:id="@+id/cardUpdateAvailable"
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_platform_button_emerald"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUpdateTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🚀 يتوفر تحديث جديد! اضغط للتحديث الفوري"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnUpdateNow"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="تحديث الآن"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:focusable="true" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbUpdateDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:progressTint="#22D3EE"
                    android:max="100"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2-Column Main Dashboard Container -->
            <LinearLayout
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Left Column (420dp): Pairing & Server Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_device_card_normal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 اقتران التلفزيون بالمنصة"
                        android:textColor="#38BDF8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="امسح الـ QR بكاميرا الموبايل لربط أجهزة المنزل الذكي."
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="14dp" />

                    <!-- QR Code Frame & Pairing Info Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- QR Container with 14dp rounded corners -->
                        <FrameLayout
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:background="@drawable/bg_qr_card"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/ivQrCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:contentDescription="Pairing QR Code" />

                            <ProgressBar
                                android:id="@+id/pbQrLoading"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#22D3EE" />
                        </FrameLayout>

                        <!-- Code & Status -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="كود الربط:"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPairingCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QL-----"
                                android:textColor="#38BDF8"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:id="@+id/tvPairingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الحالة: في انتظار المسح..."
                                android:textColor="#FBBF24"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Re-Pair Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnResetPairing"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_platform_button_slate"
                        android:backgroundTint="@null"
                        android:text="🔄 إعادة الاقتران مع سيرفر جديد (RE-PAIR)"
                        android:textColor="@color/color_btn_slate_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Right Column (440dp): Remote Key & Quick Controls Card -->
                <LinearLayout
                    android:id="@+id/cardRemoteConfig"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.08"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_device_card_normal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 تخصيص زر القائمة السريعة للريموت"
                        android:textColor="#38BDF8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الزر بالريموت لفتح قائمة الأجهزة العائمة فوراً فوق أي تطبيق."
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Key Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_platform_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الزر المسجل حالياً:"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCurrentRemoteKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الزر الأزرق (Blue Key - 134)"
                                android:textColor="#F8FAFC"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCaptureRemoteKey"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_platform_button_cyan"
                            android:backgroundTint="@null"
                            android:text="🎯 تسجيل زر جديد"
                            android:textColor="@color/color_btn_cyan_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="14dp"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Mode Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="نوع الضغطة (Trigger Mode):"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeSingle"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_selected"
                            android:backgroundTint="@null"
                            android:text="✓ ضغطة عادية"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp"
                            android:focusable="true" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeHold"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_unselected"
                            android:backgroundTint="@null"
                            android:text="مطولة 500ms"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:layout_marginEnd="6dp"
                            android:focusable="true" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeDouble"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_unselected"
                            android:backgroundTint="@null"
                            android:text="ضغطتان 350ms"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Action 1: Test Overlay Button (Emerald Glass Matching Platform) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="⚡ تجربة فتح القائمة العائمة الآن  →"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:focusable="true" />

                    <!-- Action 2: Accessibility Service Button (Emerald/Slate Glass) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnOpenAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="✓ خدمة التقاط الريموت مفعلة (Active)"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
