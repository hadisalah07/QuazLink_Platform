<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060913">

    <!-- Dynamic Constellation Particle Background (Matching Web Platform) -->
    <com.quazcode.quazhome.tv.ui.view.StarFieldView
        android:id="@+id/starFieldBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="20dp"
            android:gravity="center_horizontal">

            <!-- Top Header: Logo + Title + Version + OTA Banner -->
            <LinearLayout
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/quazlink_logo"
                    android:contentDescription="QuazLink Logo"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Official QuazHome TV Brand Typography (Matching Platform Hero 1:1) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Quaz: Gradient Q + White uaz -->
                        <TextView
                            android:id="@+id/tvLogoQ"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Q"
                            android:textColor="#38BDF8"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvLogoUaz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="uaz"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <!-- Home: White-to-Silver Gradient -->
                        <TextView
                            android:id="@+id/tvLogoHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home"
                            android:textColor="#E2E8F0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:layout_marginStart="1dp" />

                        <!-- TV: Futuristic Neon Cyan Pill Badge -->
                        <TextView
                            android:id="@+id/tvLogoTvBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TV"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:background="@drawable/bg_platform_pill"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Subtitle: AUTOMATE • CONNECT • CONTROL (Exact match to image) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUTOMATE  •  CONNECT  •  CONTROL"
                        android:textColor="#94A3B8"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="منظومة التحكم بالمنزل الذكي عبر شاشة التلفزيون والبروجكتور"
                        android:textColor="#475569"
                        android:textSize="10.5sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الإصدار: v1.1.5 (Platform Edition)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="@drawable/bg_platform_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp" />
            </LinearLayout>

            <!-- Optional OTA In-App Update Card -->
            <LinearLayout
                android:id="@+id/cardUpdateAvailable"
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_platform_button_emerald"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUpdateTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🚀 يتوفر تحديث جديد! اضغط للتحديث الفوري"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnUpdateNow"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="تحديث الآن"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:focusable="true" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbUpdateDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:progressTint="#22D3EE"
                    android:max="100"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Container 1: Pairing & Setup Layout (Active when !isPaired, or when Settings is opened) -->
            <LinearLayout
                android:id="@+id/containerPairingSetup"
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Return to Dashboard Button (Visible only when already paired) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackToDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_platform_button_cyan"
                    android:backgroundTint="@null"
                    android:text="← العودة إلى لوحة تحكم الأجهزة الذكية (Dashboard)"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    android:focusable="true" />

                <!-- 2-Column Main Setup Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                <!-- Left Column (420dp): Pairing & Server Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_device_card_normal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 اقتران التلفزيون بالمنصة"
                        android:textColor="#38BDF8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="امسح الـ QR بكاميرا الموبايل لربط أجهزة المنزل الذكي."
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="14dp" />

                    <!-- QR Code Frame & Pairing Info Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- QR Container with 14dp rounded corners -->
                        <FrameLayout
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:background="@drawable/bg_qr_card"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/ivQrCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:contentDescription="Pairing QR Code" />

                            <ProgressBar
                                android:id="@+id/pbQrLoading"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#22D3EE" />
                        </FrameLayout>

                        <!-- Code & Status -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="كود الربط:"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPairingCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QL-----"
                                android:textColor="#38BDF8"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:id="@+id/tvPairingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الحالة: في انتظار المسح..."
                                android:textColor="#FBBF24"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Re-Pair Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnResetPairing"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_platform_button_slate"
                        android:backgroundTint="@null"
                        android:text="🔄 إعادة الاقتران مع سيرفر جديد (RE-PAIR)"
                        android:textColor="@color/color_btn_slate_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:nextFocusRight="@+id/btnTestOverlay"
                        android:nextFocusUp="@+id/btnUpdateNow"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Right Column (440dp): Remote Key & Quick Controls Card -->
                <LinearLayout
                    android:id="@+id/cardRemoteConfig"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.08"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_device_card_normal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 تخصيص زر القائمة السريعة للريموت"
                        android:textColor="#38BDF8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الزر بالريموت لفتح قائمة الأجهزة العائمة فوراً فوق أي تطبيق."
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Key Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_platform_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الزر المسجل حالياً:"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCurrentRemoteKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الزر الأزرق (Blue Key - 134)"
                                android:textColor="#F8FAFC"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCaptureRemoteKey"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_platform_button_cyan"
                            android:backgroundTint="@null"
                            android:text="🎯 تسجيل زر جديد"
                            android:textColor="@color/color_btn_cyan_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="14dp"
                            android:nextFocusLeft="@+id/btnResetPairing"
                            android:nextFocusDown="@+id/btnModeDouble"
                            android:nextFocusUp="@+id/btnUpdateNow"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Mode Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="نوع الضغطة (Trigger Mode):"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeSingle"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_selected"
                            android:backgroundTint="@null"
                            android:text="✓ ضغطة عادية"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp"
                            android:nextFocusLeft="@+id/btnResetPairing"
                            android:nextFocusRight="@+id/btnModeHold"
                            android:nextFocusUp="@+id/btnCaptureRemoteKey"
                            android:nextFocusDown="@+id/btnTestOverlay"
                            android:focusable="true" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeHold"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_unselected"
                            android:backgroundTint="@null"
                            android:text="مطولة 500ms"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:layout_marginEnd="6dp"
                            android:nextFocusLeft="@+id/btnModeSingle"
                            android:nextFocusRight="@+id/btnModeDouble"
                            android:nextFocusUp="@+id/btnCaptureRemoteKey"
                            android:nextFocusDown="@+id/btnTestOverlay"
                            android:focusable="true" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeDouble"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neon_mode_unselected"
                            android:backgroundTint="@null"
                            android:text="ضغطتان 350ms"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:nextFocusLeft="@+id/btnModeHold"
                            android:nextFocusUp="@+id/btnCaptureRemoteKey"
                            android:nextFocusDown="@+id/btnTestOverlay"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Action 1: Test Overlay Button (Emerald Glass Matching Platform) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="⚡ تجربة فتح القائمة العائمة الآن  →"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:nextFocusLeft="@+id/btnResetPairing"
                        android:nextFocusUp="@+id/btnModeSingle"
                        android:nextFocusDown="@+id/btnOpenAccessibility"
                        android:focusable="true" />

                    <!-- Action 2: Accessibility Service Button (Emerald/Slate Glass) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnOpenAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="✓ خدمة التقاط الريموت مفعلة (Active)"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:nextFocusLeft="@+id/btnResetPairing"
                        android:nextFocusUp="@+id/btnTestOverlay"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
            </LinearLayout>

            <!-- Container 2: Smart Home TV Dashboard (Active when isPaired == true) -->
            <LinearLayout
                android:id="@+id/containerDashboard"
                android:layout_width="880dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Dashboard Action Bar: Status + Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvDashboardStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🟢 متصل بـ Home Assistant بنجاح ✨"
                        android:textColor="#34D399"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Action 1: Refresh Devices -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDashboardRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_platform_button_cyan"
                        android:backgroundTint="@null"
                        android:text="🔄 تحديث الأجهزة"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp"
                        android:nextFocusDown="@+id/rvDashboardDevices"
                        android:focusable="true" />

                    <!-- Action 2: QuickBar Overlay Test -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDashboardOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_platform_button_emerald"
                        android:backgroundTint="@null"
                        android:text="⚡ القائمة العائمة"
                        android:textColor="@color/color_btn_emerald_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp"
                        android:nextFocusDown="@+id/rvDashboardDevices"
                        android:focusable="true" />

                    <!-- Action 3: Settings (Remote Key & Server) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDashboardSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_platform_button_slate"
                        android:backgroundTint="@null"
                        android:text="⚙️ إعدادات الريموت والربط"
                        android:textColor="@color/color_btn_slate_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:nextFocusDown="@+id/rvDashboardDevices"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Subtitle / Hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تحكم بأجهزة المنزل الذكي مباشرة من التلفزيون • اضغط [OK] للتشغيل/الإطفاء • استخدم ◄ ► لحرارة التكييف"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <!-- 2-Column Grid for Entities & Categories -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDashboardDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
