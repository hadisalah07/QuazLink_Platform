<?xml version="1.0" encoding="utf-8"?>
<com.quazcode.quazhome.tv.overlay.OverlayRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_sidebar"
    android:orientation="vertical"
    android:padding="20dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Header with QuazHome Logo / Title / Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/quazlink_logo"
            android:contentDescription="QuazLink Logo"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUAZHOME"
            android:textColor="@color/quaz_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <!-- Close Button (Also triggers on Back key or 10s AFK) -->
        <Button
            android:id="@+id/btnCloseOverlay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_neon_button_close"
            android:text="✕ إغلاق"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2622D3EE"
        android:layout_marginBottom="16dp" />

    <!-- RecyclerView for Devices and Scenes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:descendantFocusability="afterDescendants" />

    <!-- Footer Hint: 10s AFK Timeout & Back to Close -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ إغلاق تلقائي بعد 10 ثوانٍ • [Back] أو زر الريموت للإغلاق"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</com.quazcode.quazhome.tv.overlay.OverlayRootLayout>
