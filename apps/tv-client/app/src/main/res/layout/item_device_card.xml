<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_device_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Status Indicator / Icon Container (Matching Platform Image 2) -->
    <TextView
        android:id="@+id/tvDeviceIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_platform_pill"
        android:gravity="center"
        android:text="💡"
        android:textSize="18sp" />

    <!-- Info (Title + Subtitle) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="إضاءة الصالة"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="light.led_dimmer_hub_dimmer"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- State Pill Badge (Matching Platform Image 2) -->
    <TextView
        android:id="@+id/tvStateBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_platform_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="OFF"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginEnd="6dp" />

    <!-- Power Toggle Icon (Matching Platform Image 2) -->
    <TextView
        android:id="@+id/tvPowerIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_platform_pill"
        android:gravity="center"
        android:text="⏻"
        android:textColor="#64748B"
        android:textSize="13sp" />

</LinearLayout>
