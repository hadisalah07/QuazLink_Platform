// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  passwordHash   String?         // bcrypt hash; nullable so pre-auth rows/seed still migrate
  role           String          @default("user") // 'user', 'admin'
  lastLoginAt    DateTime?
  lastLoginIp    String?
  country        String?
  city           String?
  countryCode    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialAccounts SocialAccount[]
  campaigns      Campaign[]
  catalogs       Catalog[]
  devices        Device[]
  aiPresets      AiAdPreset[]
}

model SocialAccount {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  platform              String    // e.g., 'facebook', 'instagram'
  status                String    // 'active', 'needs_relogin', 'flagged'
  encryptedStorageState String?   // Encrypted JSON string of cookies and storage state
  fingerprint           String?   // JSON representation of browser fingerprint
  proxyId               String?   // ID of the residential proxy assigned to this account
  destinations          Json?     // [{ name, url }] — Personal Profile + Pages
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  jobs                  Job[]
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  status      String   // 'draft', 'active', 'completed'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  content     String?  // Final text to post
  mediaUrls   String[] // Array of URLs/paths for images/videos
  status      String   // 'scheduled', 'processing', 'published', 'failed'
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
}

model Job {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id])
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  status          String        // 'pending', 'active', 'completed', 'failed'
  result          String?       // Any output from the worker, e.g., Post URL or Error Message
  screenshotUrl   String?       // Proof of publication
  targetUrl       String?       // Destination URL (Homepage or specific Page URL)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Catalog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  sourceType  String    @default("custom") // 'custom', 'shopify', 'woocommerce'
  apiUrl      String
  apiKey      String?   // Encrypted AES-256 string for production
  authScheme  String    @default("bearer") // 'bearer', 'header', 'query', 'none'
  authHeader  String?   // Header name if authScheme='header'
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Device {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String    @default("My Workstation")
  platform       String    @default("win32") // 'win32', 'darwin', 'linux'
  pairingToken   String    @unique
  deviceToken    String?   @unique
  status         String    @default("offline") // 'online', 'busy', 'offline'
  ipAddress      String?
  country        String?
  city           String?
  countryCode    String?
  appVersion     String?
  lastHeartbeat  DateTime?
  keepAwake      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AiAdPreset {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetKey      String    // 'fb_ig_feed', 'tiktok_reels', 'whatsapp_direct', 'flash_sale', 'b2b_wholesale'
  title          String
  category       String    @default("social")
  systemPrompt   String    @db.Text
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, presetKey])
}

model PosTerminal {
  id                String    @id @default(uuid())
  hardwareId        String    @unique
  hostname          String?
  username          String?
  osPlatform        String?   // 'win32'
  osRelease         String?   // 'Windows 10 Pro', '6.1.7601' (Win 7)
  osArch            String?   // 'x64', 'ia32'
  cpuModel          String?
  cpuProcessorId    String?
  cpuCores          Int?
  totalMemoryMB     Int?
  motherboardUuid   String?
  motherboardSerial String?
  motherboardModel  String?
  motherboardMfr    String?
  diskModel         String?
  diskSizeGB        Int?
  biosVersion       String?
  appVersion        String?   @default("1.1.0")
  businessName      String?   @default("Retail Store")
  licenseType       String?   @default("trial")
  licenseKey        String?
  trialStartedAt    DateTime?
  ipAddress         String?
  country           String?
  city              String?
  countryCode       String?
  launchCount       Int       @default(1)
  rawHardware       Json?
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PosBranch {
  id          String   @id @default(uuid())
  tenantId    String   @default("default_tenant")
  branchCode  String
  name        String
  city        String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, branchCode])
  @@index([tenantId])
}

model PosInvoiceSync {
  id              String    @id @default(uuid())
  tenantId        String    @default("default_tenant")
  branchCode      String    @default("main")
  hardwareId      String?
  localInvoiceId  String
  invoiceNumber   String
  customerName    String?
  customerPhone   String?
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  paymentMethod   String    @default("cash") // 'cash', 'card', 'split', 'credit'
  status          String    @default("completed") // 'completed', 'refunded', 'voided'
  cashierName     String?
  itemsCount      Int       @default(1)
  rawItems        Json?
  localCreatedAt  DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@unique([tenantId, branchCode, localInvoiceId])
  @@index([tenantId, branchCode, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

model PosShiftSync {
  id             String    @id @default(uuid())
  tenantId       String    @default("default_tenant")
  branchCode     String    @default("main")
  hardwareId     String?
  localShiftId   String
  cashierName    String
  status         String    @default("open") // 'open', 'closed'
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  startingCash   Float     @default(0)
  expectedCash   Float     @default(0)
  actualCash     Float     @default(0)
  difference     Float     @default(0)
  totalSales     Float     @default(0)
  invoicesCount  Int       @default(0)
  rawZReport     Json?
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, branchCode, localShiftId])
  @@index([tenantId, status])
  @@index([tenantId, branchCode, status])
}

model PosBranchDailyStats {
  id           String   @id @default(uuid())
  tenantId     String   @default("default_tenant")
  branchCode   String
  date         String   // 'YYYY-MM-DD'
  totalSales   Float    @default(0)
  totalInvoices Int     @default(0)
  totalCash    Float    @default(0)
  totalCard    Float    @default(0)
  totalCredit  Float    @default(0)
  netProfit    Float    @default(0)
  activeShifts Int      @default(0)
  lastSyncAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, branchCode, date])
  @@index([tenantId, date])
}


