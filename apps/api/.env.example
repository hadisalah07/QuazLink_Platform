# Copy to .env and fill in real values.

# --- Database / queue ---
DATABASE_URL="postgresql://admin:password123@localhost:5432/saas_automation?schema=public"
REDIS_URL="redis://localhost:6379"

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Auth (Phase 1) ---
# Secret used to sign session JWTs (HS256). Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Shared secret required to sign up (invite-only registration).
INVITE_CODE=change-me-invite-code
# Origin allowed to send credentialed requests (the web dashboard).
WEB_ORIGIN=http://localhost:3000

# --- Encryption (FB session / catalog API keys) ---
# 32-byte secret for AES-256. Changing it orphans existing encrypted rows.
ENCRYPTION_KEY=change-me-32-byte-encryption-key
