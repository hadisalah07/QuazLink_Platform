# =================================================================
# QuazLink Cloud Platform — Production Environment Variables
# Copy these values into your Coolify Environment Variables settings
# =================================================================

# 1. High-Security Keys (Military-Grade Cryptography)
# Generate a strong 32+ character random string for each:
ENCRYPTION_KEY="your-ultra-secure-32-byte-encryption-key-for-sessions"
JWT_SECRET="your-ultra-secure-jwt-secret-key-for-tokens"

# 2. Database & Cache Credentials
POSTGRES_USER="admin"
POSTGRES_PASSWORD="your-strong-production-postgres-password"
POSTGRES_DB="saas_automation"

# 3. AI Copilot Key
GEMINI_API_KEY="your-google-gemini-api-key"

# 4. Domain URLs (Configured in Coolify / DNS)
WEB_ORIGIN="https://app.yourdomain.com"
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
